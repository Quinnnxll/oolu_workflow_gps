# The TLS front door. Caddy provisions and renews certificates itself
# (Let's Encrypt) — with Cloudflare DNS in front, keep the proxy cloud
# ON and set SSL/TLS mode to "Full (strict)" so the orange cloud speaks
# HTTPS to this box, never plain HTTP.
#
# Two doors, one gateway: the app domain(s) serve the user shell (the
# chat), the admin domain serves the operator console. The gateway picks
# the face by the Host header Caddy forwards, so both blocks proxy to
# the same container.

# The user-facing app. OOLU_DOMAIN may list several hostnames separated
# by ", " (e.g. "app.example.com, www.app.example.com").
{$OOLU_DOMAIN} {
	encode gzip
	reverse_proxy oolu:8765
}

# The operator's admin console — same gateway, the admin face.
{$OOLU_ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy oolu:8765
}

# The investor panel — a STATIC page, served here rather than proxied:
# the gateway answers every non-admin Host with the user shell, so this
# hostname must never reach it as a page request (and must not be
# listed in OOLU_DOMAIN, or the app shell wins). The panel's OWN API
# calls ride the same origin: /v1/* proxies to the gateway, so the
# page needs no host entry and no CORS admission — sign in and it is
# live. Unset, OOLU_INVESTORS_DOMAIN defaults (in
# docker-compose.prod.yml) to a loopback placeholder so Caddy still
# boots without this door.
{$OOLU_INVESTORS_DOMAIN} {
	encode gzip
	@api path /v1/*
	handle @api {
		reverse_proxy oolu:8765
	}
	handle {
		# The deploy directory rides in as one mount (see the compose
		# file: single-file mounts go stale on git deploys). Every page
		# path rewrites to the panel, so nothing else in the directory
		# is reachable — and no-cache makes browsers REVALIDATE on each
		# visit (ETag keeps that a cheap 304), so a deployed panel is
		# the panel people see.
		root * /srv/deploy
		rewrite * /investor-panel.html
		header Cache-Control "no-cache"
		file_server
	}
}
